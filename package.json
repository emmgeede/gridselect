{
  "name": "@emmgeede/gridselect",
  "version": "0.9.0",
  "description": "Dependency-free select component: chips for short lists, a searchable grid for long ones.",
  "license": "MIT",
  "author": "Michael Grossklos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emmgeede/gridselect.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/gridselect.d.ts",
      "default": "./src/gridselect.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "default": "./src/element.js"
    },
    "./gridselect.css": "./src/gridselect.css",
    "./themes/showcase.css": "./themes/showcase.css",
    "./dist/gridselect.min.js": "./dist/gridselect.min.js"
  },
  "files": [
    "src/gridselect.js",
    "src/element.js",
    "src/gridselect.css",
    "themes/showcase.css",
    "dist/gridselect.d.ts",
    "dist/element.d.ts",
    "dist/gridselect.min.js",
    "dist/gridselect-element.min.js",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "vitest run && npm run test:types",
    "types": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node scripts/element-types.js",
    "test:types": "npm run types && tsc -p test/tsconfig.json",
    "playground": "npx --yes serve -l 5173 .",
    "test:e2e": "playwright test",
    "build": "npm run types && esbuild src/gridselect.js --bundle --minify --format=iife --global-name=gridselect --footer:js=\"globalThis.gridselect=gridselect.gridselect;\" --outfile=dist/gridselect.min.js --log-level=warning && esbuild src/element.js --bundle --minify --format=iife --outfile=dist/gridselect-element.min.js --log-level=warning",
    "prepublishOnly": "npm test && npm run build",
    "screenshots": "playwright test --config playwright.screenshots.config.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "style": "./src/gridselect.css",
  "unpkg": "./dist/gridselect.min.js",
  "jsdelivr": "./dist/gridselect.min.js",
  "keywords": [
    "select",
    "radio",
    "combobox",
    "listbox",
    "accessible",
    "a11y",
    "wcag",
    "keyboard",
    "vanilla",
    "no-dependencies"
  ],
  "homepage": "https://emmgeede.github.io/gridselect/",
  "bugs": "https://github.com/emmgeede/gridselect/issues",
  "publishConfig": {
    "access": "public"
  }
}
